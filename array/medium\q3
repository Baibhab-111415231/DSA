class Solution {
  public:
    void nextPermutation(vector<int>& arr) {
        int len=arr.size();
        vector<int> sorted_array=arr;
        sort(sorted_array.begin(),sorted_array.end());
        vector<int> largest_array = sorted_array;
        reverse(largest_array.begin(), largest_array.end());
        if(arr == largest_array){
            arr=sorted_array;
            return;
        }
        int i=len-2;
        while(i>=0 && arr[i] >= arr[i+1]){
            i--;
        }
        int j=len-1;
        while(arr[j]<=arr[i]){
            j--;
        }
        swap(arr[i], arr[j]);
        reverse(arr.begin()+i+1,arr.end());
    }
};
