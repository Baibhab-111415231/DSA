class Solution {
public:
    int maximizeSum(vector<int>& arr, int k) {
        sort(arr.begin(), arr.end());
        int len = arr.size();
        for (int i = 0; i < len; i++) {
            if (arr[i] < 0 && k > 0) {
                arr[i] = -arr[i];
                k--;
            }
        }
        if (k > 0 && k % 2 != 0) {
            sort(arr.begin(), arr.end());
            arr[0] = -arr[0];
        }
        int sum = 0;
        for (int j = 0; j < len; j++) {
            sum += arr[j];
        }
        return sum;
    }
};
