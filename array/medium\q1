int kthElement(int *a, int n, int *b, int m, int k) {
    int i = 0;
    int j = 0;
    int count = 0;
    int answer;
    while(count < k) {
        if(i < n && (j >= m || a[i] <= b[j])) {
            answer = a[i];
            i++;
        }
        else {
            answer = b[j];
            j++;
        }
        count++;
    }
    return answer;
}
