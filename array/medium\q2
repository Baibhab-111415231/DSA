class Solution {
  public:
    vector<int> find(vector<int>& arr, int x) {
        int len = arr.size();
        int first = -1;
        int last = -1;
        int low = 0;
        int high = len-1;
        while (low<=high){
            int mid = low + (high-low)/2;

            if (arr[mid] == x){
                first = mid;
                high = mid-1;
            }
            else if(arr[mid] < x){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        low = 0;
        high = len-1;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (arr[mid] == x) {
                last = mid;
                low = mid + 1;    
            }
            else if (arr[mid] < x) {
                low = mid + 1;
            }
            else {
                high = mid - 1;
            }
        }
        return {first, last};
    }
};
