class Solution {
  public:
    void rearrange(vector<int> &arr) {
        int len = arr.size();
        int i, j, temp;

        for (i = 0; i < len; i++) {
            if (i % 2 == 0) {
                if (arr[i] < 0) {
                    for (j = i + 1; j < len; j++) {
                        if (arr[j] >= 0) {
                            temp = arr[j];
                            for (int k = j; k > i; k--) {
                                arr[k] = arr[k - 1];
                            }
                            arr[i] = temp;
                            break;
                        }
                    }
                    if (j == len) break; 
                }
            } 
            else {
                if (arr[i] >= 0) {
                    for (j = i + 1; j < len; j++) {
                        if (arr[j] < 0) {
                            temp = arr[j];
                            for (int k = j; k > i; k--) {
                                arr[k] = arr[k - 1];
                            }
                            arr[i] = temp;
                            break;
                        }
                    }
                    if (j == len) break;
                }
            }
        }
    }
};
